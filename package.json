{
  "name": "nextbeat-tech-bar-22",
  "private": true,
  "scripts": {
    "build": "npm run build:pdf && npm run build:html",
    "build:pdf": "marp slides.md --theme ./ideo-plus.css --allow-local-files --html --no-stdin -o dist/slides.pdf",
    "build:html": "marp slides.md --theme ./ideo-plus.css --allow-local-files --html --no-stdin -o dist/slides.html",
    "slides:pdf": "npm run build:pdf",
    "slides:html": "npm run build:html"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "4.5.1"
  },
  "overrides": {
    "@marp-team/marp-cli": {
      "puppeteer-core": "25.16.0"
    },
    "@marp-team/marp-core": {
      "katex": "0.18.2"
    }
  }
}
